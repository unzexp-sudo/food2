# --- FoodSupply ERP environment ---
# Copy to .env and adjust as needed.

# Database: SQLite for dev/demo; PostgreSQL for production, e.g.
#   postgresql+psycopg2://erp:erp@localhost:5432/erp
ERP_DATABASE_URL=sqlite:///./erp.db

# Auth
ERP_SECRET_KEY=change-me-in-production
ERP_ACCESS_TOKEN_EXPIRE_MINUTES=720

# File storage (intake originals, POD photos)
ERP_FILES_DIR=./data/files

# AI intake provider: "mock" (deterministic, no external calls) or "openai"
ERP_AI_PROVIDER=mock
ERP_OPENAI_API_KEY=
ERP_OPENAI_BASE_URL=https://api.openai.com/v1
ERP_OPENAI_MODEL=gpt-4o-mini

# CORS (Vite dev server)
ERP_CORS_ORIGINS=http://localhost:5173

# --- WeCom Gateway integration -------------------------------------------------
# Shared secret the WeCom gateway sends as X-ERP-Service-Key. Must match the
# gateway's WECOM_ERP_API_KEY — a mismatch 401s every inbound order.
ERP_SERVICE_KEY=dev-service-key
ERP_WECOM_GATEWAY_URL=http://127.0.0.1:8100
# Shared secret the ERP sends as X-Gateway-Key when pushing outbound messages.
# Must match the gateway's WECOM_GATEWAY_SERVICE_KEY.
ERP_WECOM_GATEWAY_KEY=dev-gateway-key
# Set to false to stop sending outbound WeCom notifications.
ERP_NOTIFY_ENABLED=true
