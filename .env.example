# --- FoodSupply ERP environment ---
# Copy to .env and adjust as needed.

# Database: SQLite for dev/demo; PostgreSQL for production, e.g.
#   postgresql+psycopg2://erp:erp@localhost:5432/erp
# On Railway, add a Postgres service and set this to its DATABASE_URL. Pasting
# the literal value is safest; the ${{Postgres.DATABASE_URL}} reference only
# resolves if a service with that exact name exists in the same project AND
# environment — otherwise the literal text is passed through and the app
# refuses to start (it will tell you so).
ERP_DATABASE_URL=sqlite:///./erp.db

# Durability guard. A hosted container's filesystem is ephemeral, so the SQLite
# file above is destroyed on every redeploy — taking every order, customer and
# conversation binding with it. The app therefore refuses to boot on SQLite when
# it detects a deploy marker. Set this true ONLY for a throwaway environment
# (a demo or a smoke test) where losing the data is genuinely acceptable.
ERP_ALLOW_EPHEMERAL_DATABASE=false

# Demo seed. seed.py creates five users — all with the password "erp123", one of
# them an admin — plus a demo catalog, customers, wholesalers and contracts.
# Leave UNSET (the default) to decide from the environment: seed on a laptop,
# never inside a container. Set true to force it, false to suppress it.
# ERP_SEED_DEMO_DATA=

# Bootstrap the FIRST admin on an otherwise empty database, without any demo
# data. BOTH must be set for this to do anything. This is how you get into a
# fresh production database once the demo seed is off — with no users at all
# nobody can log in. Change the password immediately afterwards.
ERP_BOOTSTRAP_ADMIN_EMAIL=
ERP_BOOTSTRAP_ADMIN_PASSWORD=

# Auth
ERP_SECRET_KEY=change-me-in-production
ERP_ACCESS_TOKEN_EXPIRE_MINUTES=720

# File storage (intake originals, POD photos)
ERP_FILES_DIR=./data/files

# AI intake provider: "mock" (deterministic, no external calls) or "openai"
ERP_AI_PROVIDER=mock
ERP_OPENAI_API_KEY=
ERP_OPENAI_BASE_URL=https://api.openai.com/v1
ERP_OPENAI_MODEL=gpt-4o-mini

# CORS (Vite dev server)
ERP_CORS_ORIGINS=http://localhost:5173

# --- WeCom Gateway integration -------------------------------------------------
# Shared secret the WeCom gateway sends as X-ERP-Service-Key. Must match the
# gateway's WECOM_ERP_API_KEY — a mismatch 401s every inbound order.
ERP_SERVICE_KEY=dev-service-key
ERP_WECOM_GATEWAY_URL=http://127.0.0.1:8100
# Shared secret the ERP sends as X-Gateway-Key when pushing outbound messages.
# Must match the gateway's WECOM_GATEWAY_SERVICE_KEY.
ERP_WECOM_GATEWAY_KEY=dev-gateway-key
# Set to false to stop sending outbound WeCom notifications.
ERP_NOTIFY_ENABLED=true
